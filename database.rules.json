{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "room": { ".validate": "newData.isString() && newData.val().matches(/^[1-9][0-9]{5}$/)" },
        "$other": { ".validate": false }
      }
    },

    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[1-9][0-9]{5}$/)",
        ".write": "auth != null && $code.matches(/^[1-9][0-9]{5}$/) && ((newData.exists() && (!data.exists() || data.child('meta/expireAt').val() < now) && newData.child('meta/host').val() === auth.uid && newData.child('meta/createdAt').val() === now && newData.child('seats/0').val() === auth.uid && newData.child('players').child(auth.uid).exists()) || (!newData.exists() && data.child('meta/host').val() === auth.uid))",

        "meta": {
          ".validate": "newData.hasChildren(['host', 'createdAt', 'expireAt', 'maxPlayers', 'status', 'version'])",
          "host": {
            ".write": "auth != null && newData.isString() && data.parent().parent().child('players').child(newData.val()).exists() && ((data.val() === auth.uid) || (newData.val() === auth.uid && (!data.parent().parent().child('players').child(data.val()).exists() || data.parent().parent().child('players').child(data.val()).child('online').val() === false)))",
            ".validate": "newData.isString()"
          },
          "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() || data.parent().child('expireAt').val() < now)" },
          "expireAt": {
            ".write": "auth != null && data.parent().child('host').val() === auth.uid",
            ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 86400000"
          },
          "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 6 && (!data.exists() || newData.val() === data.val() || data.parent().child('expireAt').val() < now)" },
          "status": {
            ".write": "auth != null && data.parent().child('host').val() === auth.uid",
            ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing')"
          },
          "version": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() || data.parent().child('expireAt').val() < now)" },
          "$other": { ".validate": false }
        },

        "settings": {
          ".write": "auth != null && data.parent().child('meta/host').val() === auth.uid",
          ".validate": "newData.hasChildren(['theme', 'rules', 'ammo'])",
          "theme": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}$/)" },
          "rules": {
            ".validate": "newData.hasChildren(['units', 'turnTime', 'gravity', 'wind', 'water', 'crates', 'fall'])",
            "units": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" },
            "turnTime": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90" },
            "gravity": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 2" },
            "wind": { ".validate": "newData.isBoolean()" },
            "water": { ".validate": "newData.isBoolean()" },
            "crates": { ".validate": "newData.isBoolean()" },
            "fall": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "ammo": {
            "$weapon": { ".validate": "$weapon.matches(/^[a-z]{2,12}$/) && newData.isNumber() && newData.val() >= -1 && newData.val() <= 9" }
          },
          "$other": { ".validate": false }
        },

        "seats": {
          "$seat": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && data.parent().parent().child('meta/status').val() === 'waiting' && ($seat === '0' || $seat === '1' || ($seat === '2' && data.parent().parent().child('meta/maxPlayers').val() >= 3) || ($seat === '3' && data.parent().parent().child('meta/maxPlayers').val() >= 4) || ($seat === '4' && data.parent().parent().child('meta/maxPlayers').val() >= 5) || ($seat === '5' && data.parent().parent().child('meta/maxPlayers').val() >= 6))) || (!newData.exists() && (data.val() === auth.uid || data.parent().parent().child('meta/host').val() === auth.uid)))",
            ".validate": "newData.isString() && $seat.matches(/^[0-5]$/)"
          }
        },

        "players": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || newData.parent().parent().child('seats').child(newData.child('seat').val()).val() === auth.uid)) || (!newData.exists() && data.parent().parent().child('meta/host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['seat', 'name', 'animal', 'color', 'ready', 'online', 'joinedAt'])",
            "seat": { ".validate": "newData.isString() && newData.val().matches(/^[0-5]$/)" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
            "animal": { ".validate": "newData.isString() && newData.val().matches(/^(hamster|hedgehog|rabbit|squirrel|penguin|fox)$/)" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
            "ready": { ".validate": "newData.isBoolean()" },
            "online": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },

        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && data.parent().parent().child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['uid', 'name', 'color', 'text', 'ts'])",
            "uid": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "ts": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
